<section class="featured-collection">
  <div class="featured-collection__header">
    <p class="featured-collection__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.collection != blank -%}
      <a href="{{ section.settings.collection.url }}" class="featured-collection__view-all">View all</a>
    {%- endif -%}
  </div>

  <div class="featured-collection__grid">
    {%- if section.settings.collection != blank -%}
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="product-card">
          <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder-svg' }}</div>
          <div class="product-card__info">
            <h3 class="product-card__title">Sample product</h3>
            <p class="product-card__price">$0.00</p>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Just landed"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
