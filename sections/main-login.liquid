<div class="account-form-page">
  <div class="account-form-page__panel" data-login-panel>
    <h1 class="account-form-page__title">{{ 'customer.login.title' | t }}</h1>

    {%- form 'customer_login', class: 'contact-form__form' -%}
      {%- if form.errors -%}
        <div class="contact-form__errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="contact-form__field">
        <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
        <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="off" required>
      </div>

      <div class="contact-form__field">
        <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
        <input type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" required>
      </div>

      <button type="button" class="account-form__link" data-show-recover>{{ 'customer.login.forgot_password' | t }}</button>

      <button type="submit" class="button">{{ 'customer.login.sign_in' | t }}</button>
    {%- endform -%}

    <p class="account-form-page__footer">
      {{ 'customer.login.create_account' | t }}
      <a href="{{ routes.account_register_url }}">{{ 'customer.login.create_account_link' | t }}</a>
    </p>
  </div>

  <div class="account-form-page__panel" data-recover-panel hidden>
    <h1 class="account-form-page__title">{{ 'customer.recover_password.title' | t }}</h1>
    <p class="account-form-page__text">{{ 'customer.recover_password.subtext' | t }}</p>

    {%- form 'recover_customer_password', class: 'contact-form__form' -%}
      {%- if form.errors -%}
        <div class="contact-form__errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      {%- if form.posted_successfully? -%}
        <p class="contact-form__message contact-form__message--success">{{ 'customer.recover_password.success' | t }}</p>
      {%- else -%}
        <div class="contact-form__field">
          <label for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
          <input type="email" name="email" id="RecoverEmail" autocomplete="email" required>
        </div>
        <button type="submit" class="button">{{ 'customer.recover_password.submit' | t }}</button>
      {%- endif -%}
    {%- endform -%}

    <button type="button" class="account-form__link" data-show-login>{{ 'customer.recover_password.cancel' | t }}</button>
  </div>
</div>

<script src="{{ 'customer-accounts.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Main login"
}
{% endschema %}
