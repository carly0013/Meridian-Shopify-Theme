<div class="password-page__inner">
  {%- if settings.logo != blank -%}
    {%- assign logo_height = 160.0 | divided_by: settings.logo.aspect_ratio | round -%}
    <img src="{{ settings.logo | image_url: width: 320 }}" alt="{{ shop.name }}" width="160" height="{{ logo_height }}" class="password-page__logo">
  {%- else -%}
    <p class="password-page__wordmark">{{ shop.name }}</p>
  {%- endif -%}

  {%- if shop.password_message != blank -%}
    <div class="password-page__message rte">{{ shop.password_message }}</div>
  {%- else -%}
    <p class="password-page__message">{{ 'password_page.opening_soon' | t }}</p>
  {%- endif -%}

  {%- form 'storefront_password', class: 'password-page__form' -%}
    {%- if form.errors -%}
      <p class="password-page__error">{{ 'password_page.wrong_password' | t }}</p>
    {%- endif -%}
    <label class="visually-hidden" for="Password">{{ 'password_page.password_label' | t }}</label>
    <input type="password" name="password" id="Password" class="password-page__input" placeholder="{{ 'password_page.password_label' | t }}">
    <button type="submit" class="button">{{ 'password_page.enter' | t }}</button>
  {%- endform -%}

  {%- if shop.email != blank -%}
    <a href="mailto:{{ shop.email }}" class="password-page__admin-link">{{ 'password_page.admin_link' | t }}</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Main password"
}
{% endschema %}
