<div class="password-page">
  <a href="{{ routes.root_url }}" class="password-page__logo">
    {%- if settings.logo != blank -%}
      <img
        src="{{ settings.logo | image_url: width: 320 }}"
        alt="{{ shop.name }}"
        width="160"
        height="{{ 160.0 | divided_by: settings.logo.aspect_ratio | round }}"
      >
    {%- else -%}
      {{ shop.name }}
    {%- endif -%}
  </a>

  {%- if section.settings.eyebrow != blank -%}
    <p class="password-page__eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  <h1 class="password-page__heading">{{ section.settings.heading }}</h1>
  {%- if section.settings.text != blank -%}
    <div class="password-page__text rte">{{ section.settings.text }}</div>
  {%- endif -%}

  {%- form 'customer', class: 'password-page__notify-form' -%}
    <input type="hidden" name="contact[tags]" value="prospect,notify-launch">
    <div class="password-page__notify-row">
      <label class="visually-hidden" for="PasswordNotifyEmail">{{ 'general.newsletter.email_label' | t }}</label>
      <input
        type="email"
        name="contact[email]"
        id="PasswordNotifyEmail"
        placeholder="{{ 'general.newsletter.email_label' | t }}"
        required
      >
      <button type="submit">{{ 'newsletter.submit' | t }}</button>
    </div>
    {%- if form.posted_successfully? -%}
      <p class="password-page__message password-page__message--success">{{ 'newsletter.subscribed' | t }}</p>
    {%- elsif form.errors -%}
      <p class="password-page__message password-page__message--error">{{ form.errors.messages['contact[email]'] | default: 'Please enter a valid email.' }}</p>
    {%- endif -%}
  {%- endform -%}

  <details class="password-page__unlock">
    <summary>{{ 'general.password_page.login_form_heading' | t }}</summary>
    {%- form 'storefront_password', class: 'password-page__unlock-form' -%}
      {%- if form.errors -%}
        <p class="password-page__error">{{ 'general.password_page.login_form_error' | t }}</p>
      {%- endif -%}
      <label class="visually-hidden" for="PasswordInput">{{ 'general.password_page.login_password' | t }}</label>
      <input
        type="password"
        name="password"
        id="PasswordInput"
        placeholder="{{ 'general.password_page.login_password_placeholder' | t }}"
        required
      >
      <button type="submit">{{ 'general.password_page.login_form_submit' | t }}</button>
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Coming soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meridian is being made ready"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Full-grain leather goods, hand-cut and finished. Leave your email and we'll let you know the moment we open.</p>"
    }
  ]
}
{% endschema %}
