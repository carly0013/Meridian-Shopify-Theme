<section class="newsletter">
  <div class="newsletter__inner">
    <p class="newsletter__label">{{ section.settings.label }}</p>
    <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail">{{ 'general.newsletter.email_label' | t }}</label>
      <input
        type="email"
        name="contact[email]"
        id="NewsletterEmail"
        class="newsletter__input"
        placeholder="{{ 'general.newsletter.email_label' | t }}"
        required
      >
      <button type="submit" class="newsletter__submit">{{ 'newsletter.submit' | t }}</button>

      {%- if form.posted_successfully? -%}
        <p class="newsletter__message newsletter__message--success">{{ 'newsletter.subscribed' | t }}</p>
      {%- elsif form.errors -%}
        <p class="newsletter__message newsletter__message--error">{{ form.errors.messages['contact[email]'] | default: 'Please enter a valid email.' }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Correspondence"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Notes on new pieces, before they're released"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
