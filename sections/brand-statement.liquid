<section class="statement">
  {%- if section.settings.eyebrow != blank -%}
    <p class="statement__eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  <blockquote class="statement__quote">{{ section.settings.quote }}</blockquote>
  {%- if section.settings.attribution != blank -%}
    <cite class="statement__attribution">{{ section.settings.attribution }}</cite>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Brand statement",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our philosophy"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Statement",
      "default": "We don't design for a season. We design for a decade."
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution",
      "default": "— Founder's note"
    }
  ],
  "presets": [
    {
      "name": "Brand statement"
    }
  ]
}
{% endschema %}
