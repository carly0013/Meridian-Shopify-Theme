{%- paginate collections by 24 -%}
<div class="list-collections">
  <div class="list-collections__header">
    <h1 class="list-collections__title">{{ 'general.list_collections.title' | t }}</h1>
  </div>

  <div class="list-collections__grid">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="collection-card">
        <div class="collection-card__media">
          {%- if collection.featured_image -%}
            <img
              src="{{ collection.featured_image | image_url: width: 800 }}"
              srcset="{{ collection.featured_image | image_url: width: 500 }} 500w, {{ collection.featured_image | image_url: width: 800 }} 800w"
              sizes="(max-width: 749px) 50vw, 33vw"
              alt="{{ collection.featured_image.alt | escape }}"
              loading="lazy"
              width="{{ collection.featured_image.width }}"
              height="{{ collection.featured_image.height }}"
            >
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder-svg' }}
          {%- endif -%}
        </div>
        <h2 class="collection-card__title">{{ collection.title }}</h2>
      </a>
    {%- endfor -%}
  </div>

  {%- if paginate.pages > 1 -%}
    <nav class="pagination" aria-label="{{ 'collections.pagination.label' | t }}">
      {%- if paginate.previous -%}
        <a href="{{ paginate.previous.url }}" class="pagination__link">{{ 'collections.pagination.previous' | t }}</a>
      {%- endif -%}
      <span class="pagination__status">{{ 'collections.pagination.page_of' | t: current: paginate.current_page, total: paginate.pages }}</span>
      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}" class="pagination__link">{{ 'collections.pagination.next' | t }}</a>
      {%- endif -%}
    </nav>
  {%- endif -%}
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Main list of collections"
}
{% endschema %}
