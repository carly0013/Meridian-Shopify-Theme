<header class="site-header">
  <div class="site-header__row">
    <button class="site-header__menu-toggle" aria-expanded="false" aria-controls="MobileNav" data-menu-toggle>
      <span></span><span></span><span></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if settings.logo != blank -%}
        {%- assign logo_height = 160.0 | divided_by: settings.logo.aspect_ratio | round -%}
        <img src="{{ settings.logo | image_url: width: 320 }}" alt="{{ shop.name }}" width="160" height="{{ logo_height }}" loading="eager">
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <a href="{{ routes.cart_url }}" class="site-header__cart">
      <span class="visually-hidden">{{ 'general.cart.title' | t }}</span>
      <svg class="site-header__cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <path d="M6.5 8h11l-.9 11.4a1 1 0 0 1-1 .9H8.4a1 1 0 0 1-1-.9L6.5 8Z" stroke-linejoin="round" stroke-linecap="round"/>
        <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke-linecap="round"/>
      </svg>
      {%- if cart.item_count > 0 -%}
        <span class="site-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      {%- endif -%}
    </a>
  </div>

  {%- if section.settings.menu != blank -%}
    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__nav-list">
        {%- for link in section.settings.menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}

  <div id="MobileNav" class="mobile-nav" data-mobile-nav hidden>
    <ul class="mobile-nav__list">
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endfor -%}
    </ul>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
