<div id="predictive-search-results" class="predictive-search" data-predictive-search-results {% unless predictive_search.performed %}hidden{% endunless %}>
  {%- if predictive_search.performed -%}
    {%- assign total_results = predictive_search.resources.results.products.size | plus: predictive_search.resources.results.pages.size | plus: predictive_search.resources.results.articles.size -%}
    {%- if total_results == 0 -%}
      <p class="predictive-search__empty">{{ 'general.search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- else -%}
      {%- if predictive_search.resources.results.products.size > 0 -%}
        <div class="predictive-search__group">
          <p class="predictive-search__group-title">{{ 'general.search.products' | t }}</p>
          <ul class="predictive-search__list">
            {%- for product in predictive_search.resources.results.products -%}
              <li>
                <a href="{{ product.url }}" class="predictive-search__item">
                  {%- if product.featured_media -%}
                    <span class="predictive-search__item-media">
                      <img src="{{ product.featured_media | image_url: width: 80 }}" alt="" width="40" height="40" loading="lazy">
                    </span>
                  {%- endif -%}
                  <span class="predictive-search__item-text">
                    <span class="predictive-search__item-title">{{ product.title }}</span>
                    <span class="predictive-search__item-price">{{ product.price | money }}</span>
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if predictive_search.resources.results.pages.size > 0 -%}
        <div class="predictive-search__group">
          <p class="predictive-search__group-title">{{ 'general.search.pages' | t }}</p>
          <ul class="predictive-search__list">
            {%- for page in predictive_search.resources.results.pages -%}
              <li><a href="{{ page.url }}" class="predictive-search__item predictive-search__item--text">{{ page.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if predictive_search.resources.results.articles.size > 0 -%}
        <div class="predictive-search__group">
          <p class="predictive-search__group-title">{{ 'general.search.articles' | t }}</p>
          <ul class="predictive-search__list">
            {%- for article in predictive_search.resources.results.articles -%}
              <li><a href="{{ article.url }}" class="predictive-search__item predictive-search__item--text">{{ article.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Predictive search"
}
{% endschema %}
