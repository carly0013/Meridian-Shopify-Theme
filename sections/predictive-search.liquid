{%- if predictive_search.resources.results.products.size > 0 -%}
  <div class="header-search__result-list">
    {%- for product in predictive_search.resources.results.products -%}
      <a href="{{ product.url }}" class="header-search__result">
        {%- if product.featured_media != blank -%}
          <img
            src="{{ product.featured_media | image_url: width: 96 }}"
            alt=""
            width="48"
            height="64"
            class="header-search__result-media"
            loading="lazy"
          >
        {%- endif -%}
        <span class="header-search__result-info">
          <span class="header-search__result-title">{{ product.title }}</span>
          <span class="header-search__result-price">
            {%- if product.price_varies -%}
              {{ product.price_min | money }}&ndash;{{ product.price_max | money }}
            {%- else -%}
              {{ product.price | money }}
            {%- endif -%}
          </span>
        </span>
      </a>
    {%- endfor -%}
  </div>
  <a href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&type=product" class="header-search__view-all">
    {{ 'general.search.view_all' | t }}
  </a>
{%- elsif predictive_search.performed -%}
  <p class="header-search__empty">{{ 'general.search.no_results' | t: terms: predictive_search.terms }}</p>
{%- endif -%}

{% schema %}
{
  "name": "Predictive search"
}
{% endschema %}
