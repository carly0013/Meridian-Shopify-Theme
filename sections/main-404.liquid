<div class="error-page">
  <p class="error-page__eyebrow">404</p>
  <h1 class="error-page__title">{{ '404.title' | t }}</h1>
  <p class="error-page__message">{{ '404.message' | t }}</p>

  <form action="{{ routes.search_url }}" method="get" role="search" class="error-page__search">
    <input type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" class="error-page__search-input">
    <input type="hidden" name="type" value="product,article,page">
    <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
  </form>

  <a href="{{ routes.root_url }}" class="error-page__home-link">{{ '404.home_link' | t }}</a>
</div>

{% schema %}
{
  "name": "Main 404"
}
{% endschema %}
