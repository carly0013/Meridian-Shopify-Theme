<div class="error-404">
  <p class="error-404__eyebrow">{{ 'general.404.eyebrow' | t }}</p>
  <h1 class="error-404__title">{{ 'general.404.title' | t }}</h1>
  <p class="error-404__text">{{ 'general.404.text' | t }}</p>
  <div class="error-404__actions">
    <a href="{{ routes.root_url }}" class="button">{{ 'general.404.home' | t }}</a>
    <a href="{{ routes.all_products_collection_url }}" class="button button--outline">{{ 'general.404.shop' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "404 page"
}
{% endschema %}
