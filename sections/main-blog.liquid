{%- paginate blog.articles by 12 -%}
<div class="blog-page">
  <div class="blog-page__header">
    <h1 class="blog-page__title">{{ blog.title }}</h1>
  </div>

  {%- if blog.articles.size == 0 -%}
    <p class="blog-page__empty">{{ 'blog.general.no_articles' | t }}</p>
  {%- else -%}
    <div class="blog-page__grid">
      {%- for article in blog.articles -%}
        <article class="article-card">
          <a href="{{ article.url }}" class="article-card__media">
            {%- if article.image -%}
              <img
                src="{{ article.image | image_url: width: 800 }}"
                srcset="{{ article.image | image_url: width: 500 }} 500w, {{ article.image | image_url: width: 800 }} 800w"
                sizes="(max-width: 749px) 100vw, 33vw"
                alt="{{ article.image.alt | escape }}"
                loading="lazy"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'article-card__placeholder-svg' }}
            {%- endif -%}
          </a>
          <div class="article-card__info">
            <p class="article-card__date">{{ article.published_at | date: '%B %d, %Y' }}</p>
            <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <div class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</div>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="{{ 'collections.pagination.label' | t }}">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="pagination__link">{{ 'collections.pagination.previous' | t }}</a>
        {%- endif -%}
        <span class="pagination__status">{{ 'collections.pagination.page_of' | t: current: paginate.current_page, total: paginate.pages }}</span>
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="pagination__link">{{ 'collections.pagination.next' | t }}</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endif -%}
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Main blog"
}
{% endschema %}
