<div class="account-form-page">
  <div class="account-form-page__panel">
    <h1 class="account-form-page__title">{{ 'customer.register.title' | t }}</h1>

    {%- form 'create_customer', class: 'contact-form__form' -%}
      {%- if form.errors -%}
        <div class="contact-form__errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="contact-form__row">
        <div class="contact-form__field">
          <label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
          <input type="text" name="customer[first_name]" id="RegisterFirstName" value="{{ form.first_name }}" autocomplete="given-name">
        </div>
        <div class="contact-form__field">
          <label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
          <input type="text" name="customer[last_name]" id="RegisterLastName" value="{{ form.last_name }}" autocomplete="family-name">
        </div>
      </div>

      <div class="contact-form__field">
        <label for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
        <input type="email" name="customer[email]" id="RegisterEmail" value="{{ form.email }}" autocomplete="email" autocorrect="off" autocapitalize="off" required>
      </div>

      <div class="contact-form__field">
        <label for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
        <input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required>
      </div>

      <button type="submit" class="button">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}

    <p class="account-form-page__footer">
      {{ 'customer.register.already_have_account' | t }}
      <a href="{{ routes.account_login_url }}">{{ 'customer.register.sign_in_link' | t }}</a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Main register"
}
{% endschema %}
