{%- comment -%}
  Accepts: form (the address form object), form_id (string, unique suffix for element IDs), is_default (boolean, optional)
{%- endcomment -%}
<div class="contact-form__row">
  <div class="contact-form__field">
    <label for="AddressFirstName{{ form_id }}">{{ 'customer.addresses.first_name' | t }}</label>
    <input type="text" id="AddressFirstName{{ form_id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
  </div>
  <div class="contact-form__field">
    <label for="AddressLastName{{ form_id }}">{{ 'customer.addresses.last_name' | t }}</label>
    <input type="text" id="AddressLastName{{ form_id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
  </div>
</div>

<div class="contact-form__field">
  <label for="AddressCompany{{ form_id }}">{{ 'customer.addresses.company' | t }}</label>
  <input type="text" id="AddressCompany{{ form_id }}" name="address[company]" value="{{ form.company }}" autocomplete="organization">
</div>

<div class="contact-form__field">
  <label for="AddressAddress1{{ form_id }}">{{ 'customer.addresses.address1' | t }}</label>
  <input type="text" id="AddressAddress1{{ form_id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
</div>

<div class="contact-form__field">
  <label for="AddressAddress2{{ form_id }}">{{ 'customer.addresses.address2' | t }}</label>
  <input type="text" id="AddressAddress2{{ form_id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
</div>

<div class="contact-form__row">
  <div class="contact-form__field">
    <label for="AddressCity{{ form_id }}">{{ 'customer.addresses.city' | t }}</label>
    <input type="text" id="AddressCity{{ form_id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
  </div>
  <div class="contact-form__field">
    <label for="AddressZip{{ form_id }}">{{ 'customer.addresses.zip' | t }}</label>
    <input type="text" id="AddressZip{{ form_id }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code">
  </div>
</div>

<div class="contact-form__field">
  <label for="AddressCountry{{ form_id }}">{{ 'customer.addresses.country' | t }}</label>
  <select id="AddressCountry{{ form_id }}" name="address[country]" data-default="{{ form.country }}" autocomplete="country">
    {{ all_country_option_tags }}
  </select>
</div>

<div class="contact-form__field" id="AddressProvinceContainer{{ form_id }}">
  <label for="AddressProvince{{ form_id }}">{{ 'customer.addresses.province' | t }}</label>
  <select id="AddressProvince{{ form_id }}" name="address[province]" data-default="{{ form.province }}"></select>
</div>

<div class="contact-form__field">
  <label for="AddressPhone{{ form_id }}">{{ 'customer.addresses.phone' | t }}</label>
  <input type="tel" id="AddressPhone{{ form_id }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
</div>

<div class="contact-form__field contact-form__field--checkbox">
  <label>
    <input type="checkbox" name="address[default]" value="1" {% if is_default %}checked{% endif %}>
    {{ 'customer.addresses.set_default' | t }}
  </label>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new window.Shopify.CountryProvinceSelector('AddressCountry{{ form_id }}', 'AddressProvince{{ form_id }}', {
      hideElement: 'AddressProvinceContainer{{ form_id }}'
    });
  });
</script>
