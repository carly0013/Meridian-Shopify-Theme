{%- comment -%}
  Accepts: platform (string) — one of instagram, facebook, tiktok, pinterest, youtube, x
{%- endcomment -%}
{%- case platform -%}
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17.5" cy="6.5" r="1"/>
    </svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M14 8h2V5h-2a3 3 0 0 0-3 3v2H9v3h2v6h3v-6h2.2l.8-3H14V8Z" stroke-linejoin="round"/>
    </svg>
  {%- when 'tiktok' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M14 4v10.5a3 3 0 1 1-3-3" stroke-linecap="round"/>
      <path d="M14 4c.4 2.2 2 4 4.5 4.3" stroke-linecap="round"/>
    </svg>
  {%- when 'pinterest' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="12" cy="12" r="9"/>
      <path d="M9.5 19c1-3 2-6.5 2-8.5a2.5 2.5 0 0 1 5 0c0 2-1 4.5-2 5.5" stroke-linecap="round"/>
    </svg>
  {%- when 'youtube' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <rect x="3" y="6" width="18" height="12" rx="3"/>
      <path d="M10 9.5v5l4.5-2.5Z" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'x' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M5 5l14 14M19 5 5 19" stroke-linecap="round"/>
    </svg>
{%- endcase -%}
