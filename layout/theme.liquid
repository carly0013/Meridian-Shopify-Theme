<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#1B1815">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- assign social_image_url = page_image | image_url: width: 1200 -%}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:type" content="{% if template contains 'product' %}product{% else %}website{% endif %}">
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if page_image -%}
    <meta property="og:image" content="https:{{ social_image_url }}">
    <meta property="og:image:secure_url" content="https:{{ social_image_url }}">
    <meta property="og:image:width" content="1200">
  {%- endif -%}
  {%- if template contains 'product' -%}
    <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | divided_by: 100.00 }}">
    <meta property="product:price:currency" content="{{ shop.currency }}">
  {%- endif -%}

  <meta name="twitter:card" content="{% if page_image %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ page_title }}">
  {%- if page_description -%}
    <meta name="twitter:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if page_image -%}
    <meta name="twitter:image" content="https:{{ social_image_url }}">
  {%- endif -%}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
      {%- if settings.logo -%},
      "logo": {{ settings.logo | image_url: width: 300 | prepend: 'https:' | json }}
      {%- endif -%}
    }
  </script>

  {%- if template contains 'product' -%}
    {%- assign seo_variant = product.selected_or_first_available_variant -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "Product",
        "name": {{ product.title | json }},
        "description": {{ product.description | strip_html | json }},
        "image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],
        "sku": {{ seo_variant.sku | json }},
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | json }}
        },
        "offers": {
          "@type": "Offer",
          "url": {{ shop.url | append: product.url | json }},
          "priceCurrency": {{ shop.currency | json }},
          "price": {{ seo_variant.price | divided_by: 100.00 | json }},
          "availability": "https://schema.org/{% if seo_variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition"
        }
      }
    </script>
  {%- endif -%}

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400;700&family=Manrope:wght@400;700&display=swap" rel="stylesheet">

  {%- style -%}
    :root {
      --color-bg: {{ settings.color_background | default: '#1B1815' }};
      --color-surface: {{ settings.color_surface | default: '#26211C' }};
      --color-text: {{ settings.color_text | default: '#F3EFE8' }};
      --color-muted: {{ settings.color_muted | default: '#BFB3A0' }};
      --color-accent: {{ settings.color_accent | default: '#C9483D' }};
      --color-accent-glow: {{ settings.color_accent | default: '#C9483D' | color_modify: 'alpha', 0.16 }};
      --color-line: {{ settings.color_line | default: '#443B2F' }};
      --color-dark: {{ settings.color_dark | default: '#100D0B' }};
      --color-dark-text: {{ settings.color_dark_text | default: '#F3EFE8' }};
      --color-dark-text-muted: {{ settings.color_dark_text | default: '#F3EFE8' | color_modify: 'alpha', 0.6 }};
      --border-width: {{ settings.border_width | default: 16 }}px;
      --color-border: {{ settings.color_border | default: '#4D4235' }};
      --frame-radius: {{ settings.border_radius | default: 28 }}px;
      --radius: {{ settings.corner_radius | default: 16 }}px;

      --font-display: 'Bodoni Moda', Georgia, serif;
      --font-body: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;

      --page-width: {{ settings.page_width | default: 1400 }}px;
      --gutter: clamp(20px, 4vw, 64px);

      color-scheme: dark;
    }
  {%- endstyle -%}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
</head>
<body class="template-{{ request.page_type }}" data-cart-add-url="{{ routes.cart_add_url }}">

  <a class="visually-hidden skip-to-content" href="#MainContent">Skip to content</a>

  <div class="site-frame">

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" class="main-content">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

  </div>

  {% section 'cart-drawer' %}

  <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>

</body>
</html>
