<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#1B1815">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400;0,700;1,700&family=Manrope:wght@400;700&display=swap" rel="stylesheet">

  {%- style -%}
    :root {
      --color-bg: {{ settings.color_background | default: '#1B1815' }};
      --color-surface: {{ settings.color_surface | default: '#26211C' }};
      --color-text: {{ settings.color_text | default: '#F3EFE8' }};
      --color-muted: {{ settings.color_muted | default: '#A79A87' }};
      --color-accent: {{ settings.color_accent | default: '#C9483D' }};
      --color-accent-glow: {{ settings.color_accent | default: '#C9483D' | color_modify: 'alpha', 0.16 }};
      --color-line: {{ settings.color_line | default: '#342D25' }};
      --color-dark: {{ settings.color_dark | default: '#100D0B' }};
      --color-dark-text: {{ settings.color_dark_text | default: '#F3EFE8' }};
      --color-dark-text-muted: {{ settings.color_dark_text | default: '#F3EFE8' | color_modify: 'alpha', 0.6 }};
      --border-width: {{ settings.border_width | default: 16 }}px;
      --color-border: {{ settings.color_border | default: '#3D352C' }};
      --frame-radius: {{ settings.border_radius | default: 28 }}px;
      --radius: {{ settings.corner_radius | default: 16 }}px;

      --font-display: 'Bodoni Moda', Georgia, serif;
      --font-body: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;

      --page-width: {{ settings.page_width | default: 1400 }}px;
      --gutter: clamp(20px, 4vw, 64px);

      color-scheme: dark;
    }
  {%- endstyle -%}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
</head>
<body class="template-{{ request.page_type }}">

  <a class="visually-hidden skip-to-content" href="#MainContent">Skip to content</a>

  <div class="site-frame">

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" class="main-content">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

  </div>

</body>
</html>
